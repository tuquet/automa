{
  "openapi": "3.1.0",
  "info": {
    "title": "Automa Core API",
    "description": "Tài liệu API chính thức cho Automa Core Daemon. Quản lý thực thi workflow, profile trình duyệt, local vault và các luồng sự kiện thời gian thực (SSE).",
    "version": "1.0.0",
    "license": {
      "name": "MIT"
    }
  },
  "tags": [
    { "name": "System", "description": "Quản lý hệ thống và trình duyệt lõi" },
    { "name": "Jobs", "description": "Quản lý tiến trình và thực thi kịch bản" },
    { "name": "Debugger", "description": "Tính năng gỡ lỗi kịch bản (Step-over, Resume)" },
    { "name": "Events", "description": "Luồng sự kiện thời gian thực (Server-Sent Events)" },
    { "name": "History", "description": "Lịch sử thực thi và kết quả" },
    { "name": "Profiles", "description": "Quản lý danh sách trình duyệt (Browser Profiles)" },
    { "name": "Vault", "description": "Két sắt bảo mật (Credentials, Variables, Tables)" },
    { "name": "Lint", "description": "Kiểm tra lỗi cú pháp Workflow (Diagnostics)" },
    { "name": "Secrets", "description": "Dịch vụ mã hóa dữ liệu nhạy cảm" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "operationId": "health_handler",
        "summary": "Kiểm tra trạng thái máy chủ",
        "responses": {
          "200": {
            "description": "Máy chủ hoạt động bình thường",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/system/install-browser": {
      "post": {
        "tags": ["System"],
        "operationId": "install_browser_handler",
        "summary": "Tải và cài đặt Chromium",
        "responses": {
          "200": {
            "description": "Cài đặt thành công",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemResponse" } } }
          }
        }
      }
    },
    "/api/system/browsers": {
      "delete": {
        "tags": ["System"],
        "operationId": "kill_browsers_handler",
        "summary": "Đóng toàn bộ các trình duyệt đang mở",
        "responses": {
          "200": {
            "description": "Đã diệt tiến trình",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemResponse" } } }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": ["Events"],
        "operationId": "sse_handler",
        "summary": "Đăng ký luồng sự kiện (SSE)",
        "description": "Lắng nghe các sự kiện theo thời gian thực như `profile_status_changed`, `lock_started`, `job_completed`.",
        "responses": {
          "200": {
            "description": "Kết nối luồng SSE thành công",
            "content": { "text/event-stream": {} }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": ["Jobs"],
        "operationId": "Get Active Jobs",
        "summary": "Lấy danh sách các Job đang chạy",
        "parameters": [
          { "name": "status", "in": "query", "description": "Lọc theo trạng thái (running, paused)", "required": false, "schema": { "type": "string", "example": "running" } }
        ],
        "responses": {
          "200": {
            "description": "Danh sách Jobs",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ActiveJobResponse" } }
              }
            }
          }
        }
      }
    },
    "/api/jobs/submit": {
      "post": {
        "tags": ["Jobs"],
        "operationId": "Submit Job",
        "summary": "Khởi chạy một Workflow hoặc Campaign",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitJobPayload" } } },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Job đã được khởi tạo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitJobResponse" } } }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "delete": {
        "tags": ["Jobs"],
        "operationId": "Kill Job",
        "summary": "Dừng khẩn cấp một Job (Force Kill)",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string", "example": "job-123456" } }
        ],
        "responses": {
          "200": { "description": "Job đã bị dừng" }
        }
      }
    },
    "/api/jobs/{job_id}/debugger/step": {
      "post": {
        "tags": ["Debugger"],
        "operationId": "debugger_step",
        "summary": "Điều khiển luồng Debugger",
        "description": "Ra lệnh cho tiến trình đang tạm dừng tiếp tục chạy, bỏ qua, hoặc dừng hẳn.",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string", "example": "job-123456" } }
        ],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DebuggerActionPayload" } } },
          "required": true
        },
        "responses": {
          "200": { "description": "Lệnh debug đã được gửi tới tiến trình" }
        }
      }
    },
    "/api/history": {
      "get": {
        "tags": ["History"],
        "operationId": "get_history_handler",
        "summary": "Lấy lịch sử thực thi",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "example": 50 } }
        ],
        "responses": {
          "200": {
            "description": "Danh sách lịch sử",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/JobHistoryItem" } } } }
          }
        }
      },
      "delete": {
        "tags": ["History"],
        "operationId": "clear_history_handler",
        "summary": "Xóa toàn bộ lịch sử",
        "responses": {
          "200": { "description": "Lịch sử đã được dọn sạch" }
        }
      }
    },
    "/api/history/{job_id}": {
      "delete": {
        "tags": ["History"],
        "operationId": "delete_history_item_handler",
        "summary": "Xóa một mục lịch sử",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string", "example": "job-123456" } }
        ],
        "responses": { "200": { "description": "Đã xóa" } }
      }
    },
    "/api/lint": {
      "post": {
        "tags": ["Lint"],
        "operationId": "lint_workflow_handler",
        "summary": "Phân tích và tìm lỗi cấu trúc Workflow JSON",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LintRequest" } } },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Kết quả phân tích",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LintResponse" } } }
          }
        }
      }
    },
    "/api/profiles": {
      "get": {
        "tags": ["Profiles"],
        "operationId": "get_profiles_handler",
        "summary": "Lấy danh sách Browser Profiles",
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileResponse" } } } }
          }
        }
      },
      "post": {
        "tags": ["Profiles"],
        "operationId": "create_profile_handler",
        "summary": "Tạo Profile mới",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProfileRequest" } } },
          "required": true
        },
        "responses": {
          "200": { "description": "Tạo thành công" }
        }
      }
    },
    "/api/vault/credentials": {
      "get": {
        "tags": ["Vault"],
        "operationId": "get_credentials_handler",
        "summary": "Danh sách Credentials (Mã hóa)",
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/VaultCredential" } } } }
          }
        }
      },
      "post": {
        "tags": ["Vault"],
        "operationId": "add_credential_handler",
        "summary": "Lưu trữ Credential (bắt buộc mã hóa từ Client)",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VaultCredential" } } },
          "required": true
        },
        "responses": {
          "200": { "description": "Lưu thành công", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VaultCredential" } } } }
        }
      }
    },
    "/api/vault/variables": {
      "get": {
        "tags": ["Vault"],
        "operationId": "get_variables_handler",
        "summary": "Danh sách Biến môi trường",
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/VaultVariable" } } } }
          }
        }
      },
      "post": {
        "tags": ["Vault"],
        "operationId": "add_variable_handler",
        "summary": "Thêm biến môi trường",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VaultVariable" } } },
          "required": true
        },
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VaultVariable" } } } }
        }
      }
    },
    "/api/secrets/encrypt": {
      "post": {
        "tags": ["Secrets"],
        "operationId": "encrypt_secret_handler",
        "summary": "Mã hóa một chuỗi (Plain-text -> AES-GCM)",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EncryptSecretRequest" } } },
          "required": true
        },
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EncryptSecretResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "version", "message"],
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "version": { "type": "string", "example": "1.0.0" },
          "message": { "type": "string", "example": "Daemon is running smoothly." }
        }
      },
      "SystemResponse": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Operation completed successfully" }
        }
      },
      "ActiveJobResponse": {
        "type": "object",
        "required": ["jobId", "workflowName", "status"],
        "properties": {
          "jobId": { "type": "string", "example": "job-abcxyz" },
          "workflowName": { "type": "string", "example": "Google Scraper" },
          "status": { "type": "string", "example": "running" },
          "startedAt": { "type": "string", "format": "date-time", "example": "2026-08-19T10:00:00Z" }
        }
      },
      "SubmitJobPayload": {
        "type": "object",
        "required": ["workflowPath"],
        "properties": {
          "workflowPath": { "type": "string", "example": "/path/to/workflow.json" },
          "options": {
            "type": "object",
            "properties": {
              "variables": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "example": { "keyword": "automa automation", "limit": "10" }
              },
              "headless": { "type": "boolean", "example": true },
              "browserProfile": { "type": "string", "example": "profile-main" }
            }
          }
        }
      },
      "SubmitJobResponse": {
        "type": "object",
        "required": ["jobId", "status"],
        "properties": {
          "jobId": { "type": "string", "example": "job-123456" },
          "status": { "type": "string", "example": "queued" },
          "message": { "type": "string", "example": "Job successfully placed in execution queue" }
        }
      },
      "DebuggerActionPayload": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["resume", "step-over", "stop"],
            "example": "step-over",
            "description": "Lệnh thực thi tiếp theo cho trình gỡ lỗi"
          }
        }
      },
      "JobHistoryItem": {
        "type": "object",
        "required": ["id", "name", "status", "createdAt"],
        "properties": {
          "id": { "type": "string", "example": "job-123456" },
          "name": { "type": "string", "example": "Google Scraper" },
          "status": { "type": "string", "example": "success", "enum": ["success", "error", "cancelled"] },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-08-19T10:00:00Z" },
          "duration": { "type": "integer", "example": 15000, "description": "Thời gian chạy (ms)" }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "required": ["id", "name", "is_online"],
        "properties": {
          "id": { "type": "string", "example": "profile-default" },
          "name": { "type": "string", "example": "Default Profile" },
          "is_online": { "type": "boolean", "example": true, "description": "Trạng thái trình duyệt đang mở hay đóng" },
          "user_agent": { "type": "string", "example": "Mozilla/5.0..." }
        }
      },
      "CreateProfileRequest": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "example": "profile-marketing" },
          "name": { "type": "string", "example": "Marketing Account" },
          "timezone": { "type": "string", "example": "Asia/Ho_Chi_Minh" },
          "user_agent": { "type": "string", "example": "Mozilla/5.0..." }
        }
      },
      "LintRequest": {
        "type": "object",
        "required": ["workflowData"],
        "properties": {
          "workflowData": {
            "type": "string",
            "example": "{\"nodes\": [{\"id\":\"n1\",\"type\":\"BlockClick\"}], \"edges\": []}",
            "description": "JSON string của workflow cần kiểm tra"
          }
        }
      },
      "LintIssue": {
        "type": "object",
        "required": ["severity", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["error", "warning"], "example": "warning" },
          "message": { "type": "string", "example": "Node n1 thiếu thuộc tính cssSelector" },
          "path": { "type": "string", "example": "nodes[0].data" }
        }
      },
      "LintResponse": {
        "type": "object",
        "required": ["valid", "issues"],
        "properties": {
          "valid": { "type": "boolean", "example": false },
          "issues": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LintIssue" }
          }
        }
      },
      "VaultCredential": {
        "type": "object",
        "required": ["id", "key", "value"],
        "properties": {
          "id": { "type": "string", "example": "cred-xyz" },
          "key": { "type": "string", "example": "GITHUB_TOKEN" },
          "name": { "type": "string", "example": "Github API Key" },
          "value": { "type": "string", "example": "U2FsdGVkX1+...encrypted...data", "description": "Giá trị ĐÃ ĐƯỢC MÃ HÓA (Tuyệt đối không gửi plain-text)" }
        }
      },
      "VaultVariable": {
        "type": "object",
        "required": ["id", "key", "value"],
        "properties": {
          "id": { "type": "string", "example": "var-abc" },
          "key": { "type": "string", "example": "BASE_URL" },
          "name": { "type": "string", "example": "API Endpoint" },
          "value": { "type": "string", "example": "https://api.github.com" }
        }
      },
      "EncryptSecretRequest": {
        "type": "object",
        "required": ["plaintext"],
        "properties": {
          "passphrase": { "type": "string", "example": "user_master_password", "description": "Tùy chọn. Nếu bỏ trống, Daemon sẽ gọi cấu hình gốc." },
          "plaintext": { "type": "string", "example": "my_super_secret_api_key" }
        }
      },
      "EncryptSecretResponse": {
        "type": "object",
        "required": ["encrypted_secret"],
        "properties": {
          "encrypted_secret": { "type": "string", "example": "U2FsdGVkX19abc123xyz890==" }
        }
      }
    }
  }
}