{
  "name": "Sample CLI Workflow",
  "description": "A workflow to verify Automa CLI offline execution",
  "drawflow": {
    "nodes": [
      {
        "id": "trigger_1",
        "label": "trigger",
        "type": "BlockBasic",
        "position": { "x": 100, "y": 200 },
        "data": {
          "type": "manual"
        }
      },
      {
        "id": "new_tab_1",
        "label": "new-tab",
        "type": "BlockBasic",
        "position": { "x": 300, "y": 200 },
        "data": {
          "url": "{{TEST_HTML_URL}}",
          "active": true,
          "waitTabLoaded": true
        }
      },
      {
        "id": "insert_data_1",
        "label": "insert-data",
        "type": "BlockBasic",
        "position": { "x": 500, "y": 200 },
        "data": {
          "dataList": [
            {
              "name": "cli_tested",
              "type": "variable",
              "value": "success"
            }
          ]
        }
      }
    ],
    "edges": [
      {
        "id": "edge_1",
        "source": "trigger_1",
        "target": "new_tab_1",
        "sourceHandle": "trigger_1-output-1",
        "targetHandle": "new_tab_1-input-1"
      },
      {
        "id": "edge_2",
        "source": "new_tab_1",
        "target": "insert_data_1",
        "sourceHandle": "new_tab_1-output-1",
        "targetHandle": "insert_data_1-input-1"
      }
    ]
  }
}
