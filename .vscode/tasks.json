{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "install"
      }
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "pnpm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Watch: VSCode",
      "type": "shell",
      "command": "pnpm dev:vscode",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "tsup",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Build start.*$",
          "endsPattern": "^.*Build success.*$"
        }
      }
    },
    {
      "label": "Watch: Runner",
      "type": "shell",
      "command": "pnpm dev:source:runner",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "compiled .*"
        }
      }
    },
    {
      "label": "Watch: Rust",
      "type": "shell",
      "command": "cargo watch -x run",
      "options": {
        "cwd": "${workspaceFolder}/automa-core"
      },
      "isBackground": true,
      "presentation": {
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "rust",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling|Automa Core",
          "endsPattern": "listening on"
        }
      }
    },
    {
      "label": "Run: Rust EXE",
      "type": "process",
      "command": "${workspaceFolder}/automa-core/target/release/automa-core.exe",
      "args": ["serve"],
      "options": {
        "cwd": "${workspaceFolder}/automa-core/target/release"
      },
      "isBackground": true,
      "presentation": {
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "rust-exe",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "listening on"
        }
      }
    },
    {
      "label": "Serve (Live Rust)",
      "dependsOn": [
        "Watch: Rust",
        "Watch: Runner",
        "Watch: VSCode"
      ],
      "problemMatcher": []
    },
    {
      "label": "Serve (Rust EXE)",
      "dependsOn": [
        "Run: Rust EXE",
        "Watch: Runner",
        "Watch: VSCode"
      ],
      "problemMatcher": []
    },
    {
      "label": "Watch: CLI",
      "type": "shell",
      "command": "pnpm dev:cli",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Export API Spec",
      "type": "shell",
      "command": "pnpm run export:api-spec",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Test: CLI",
      "type": "shell",
      "command": "pnpm run test:report",
      "options": {
        "cwd": "${workspaceFolder}/automa-cli"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}