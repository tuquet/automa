{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workspace: Install Dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "install"
      }
    },
    {
      "label": "Supabase: Start (Local)",
      "type": "shell",
      "command": "npx supabase start",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Supabase: Stop (Local)",
      "type": "shell",
      "command": "npx supabase stop",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Supabase: Reset (Schema Only)",
      "type": "shell",
      "command": "npm run db:reset",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Supabase: Deploy to Cloud",
      "type": "shell",
      "command": "npx supabase db push; npx supabase functions deploy",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Extensions: Start Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/automa-ex"
      },
      "problemMatcher": []
    },
    {
      "label": "Extensions: Build Production",
      "type": "shell",
      "command": "npm run build:prod-chrome",
      "options": {
        "cwd": "${workspaceFolder}/automa-ex"
      },
      "problemMatcher": []
    },
    {
      "label": "Extensions: Release & Upload Wizard",
      "type": "shell",
      "command": "node utils/release.js",
      "options": {
        "cwd": "${workspaceFolder}/automa-ex"
      },
      "problemMatcher": []
    },
    {
      "label": "Tauri: Dev",
      "type": "shell",
      "command": "npx tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/automa-dashboard"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dashboard"
      }
    },
    {
      "label": "Tauri: Build Production",
      "type": "shell",
      "command": "npx tauri build",
      "options": {
        "cwd": "${workspaceFolder}/automa-dashboard"
      },
      "problemMatcher": []
    },
    {
      "label": "Vault: Lint Workflows & Packages",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    },
    {
      "label": "Vault: Push to Database",
      "type": "shell",
      "command": "npm run push -- --project=crm",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    },
    {
      "label": "Vault: Pull from Database",
      "type": "shell",
      "command": "npm run pull -- --project=crm",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    },
    {
      "label": "Vault: Check Sync Status",
      "type": "shell",
      "command": "npm run status -- --project=crm",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    },
    {
      "label": "CLI: Run Custom Workflow",
      "type": "shell",
      "command": "node bin/cli.js --id ${input:workflowId} --extension ../automa-ex/build",
      "options": {
        "cwd": "${workspaceFolder}/automa-cli",
        "env": {
          "SUPABASE_URL": "http://127.0.0.1:54321",
          "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "cli"
      }
    },
    {
      "label": "CLI: Scan Workflow Dependencies",
      "type": "shell",
      "command": "node bin/cli.js --id ${input:workflowId} --scan-only",
      "options": {
        "cwd": "${workspaceFolder}/automa-cli",
        "env": {
          "SUPABASE_URL": "http://127.0.0.1:54321",
          "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "cli"
      }
    }
  ],
  "inputs": [
    {
      "id": "workflowId",
      "type": "promptString",
      "description": "Nhập Workflow ID muốn chạy:",
      "default": "OYsxwfjHwwlLjE9U9Gjv3"
    }
  ]
}