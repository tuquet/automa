{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Supabase: Start",
      "type": "shell",
      "command": "npx supabase start",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "supabase"
      }
    },
    {
      "label": "1. Supabase: Stop",
      "type": "shell",
      "command": "npx supabase stop",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "supabase"
      }
    },
    {
      "label": "1. Supabase: Status",
      "type": "shell",
      "command": "npx supabase status",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "supabase"
      }
    },
    {
      "label": "1. Supabase: DB Reset",
      "type": "shell",
      "command": "npx supabase db reset",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "supabase"
      }
    },
    {
      "label": "1. Supabase: ⬆️ Push Data (JSON -> DB)",
      "detail": "Đẩy toàn bộ file JSON (workflows, packages,...) từ máy lên cập nhật vào Database (Tốc độ siêu nhanh)",
      "type": "shell",
      "command": "node scripts/seed-from-folders.js",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "supabase"
      }
    },
    {
      "label": "1. Supabase: ⬇️ Pull Data (DB -> seed.sql)",
      "detail": "Kéo toàn bộ Data từ Database xuất thành 1 file seed.sql duy nhất",
      "type": "shell",
      "command": "node scripts/dump-seed.js",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "supabase"
      }
    },
    {
      "label": "1. Supabase: ⬇️ Pull Data (DB -> JSON Folders)",
      "detail": "Kéo dữ liệu mới nhất trên Database về xả thành các file JSON theo từng thư mục (Dễ quản lý code)",
      "type": "shell",
      "command": "node scripts/dump-to-folders.js",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "supabase"
      }
    },
    {
      "label": "2. Automa: Dev",
      "type": "shell",
      "command": "pnpm run dev",
      "options": {
        "cwd": "${workspaceFolder}/automa"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "2. Automa: Build",
      "type": "shell",
      "command": "pnpm run build",
      "options": {
        "cwd": "${workspaceFolder}/automa"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "0. Workspace: Install Dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "install"
      }
    },
    {
      "label": "3. CLI: Run Custom Workflow",
      "type": "shell",
      "command": "node bin/cli.js --id ${input:workflowId} --extension ../automa/build",
      "options": {
        "cwd": "${workspaceFolder}/automa-cli",
        "env": {
          "SUPABASE_URL": "http://127.0.0.1:54321",
          "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "cli"
      }
    },
    {
      "label": "3. CLI: 🔍 Scan Workflow Dependencies",
      "type": "shell",
      "command": "node bin/cli.js --id ${input:workflowId} --scan-only",
      "options": {
        "cwd": "${workspaceFolder}/automa-cli",
        "env": {
          "SUPABASE_URL": "http://127.0.0.1:54321",
          "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "cli"
      }
    },
    {
      "label": "2. Automa: Build Chrome Prod",
      "type": "shell",
      "command": "npm run build:prod-chrome",
      "options": {
        "cwd": "${workspaceFolder}/automa"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "2. Automa: Lint",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/automa"
      },
      "problemMatcher": []
    },
    {
      "label": "3. CLI: Test",
      "type": "shell",
      "command": "npm run test",
      "options": {
        "cwd": "${workspaceFolder}/automa-cli"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "cli"
      }
    },
    {
      "label": "4. Dashboard: Tauri Dev",
      "type": "shell",
      "command": "npx tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/automa-dashboard"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dashboard"
      }
    }
  ],
  "inputs": [
    {
      "id": "workflowId",
      "type": "promptString",
      "description": "Nhập Workflow ID muốn chạy:",
      "default": "OYsxwfjHwwlLjE9U9Gjv3"
    }
  ]
}
