{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workspace: Install Dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "install"
      }
    },
    {
      "label": "Supabase: Start (Local)",
      "type": "shell",
      "command": "npx supabase start",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Supabase: Stop (Local)",
      "type": "shell",
      "command": "npx supabase stop",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Supabase: Reset (Schema Only)",
      "type": "shell",
      "command": "npm run db:reset",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Supabase: Deploy to Cloud",
      "type": "shell",
      "command": "npx supabase db push; npx supabase functions deploy",
      "options": {
        "cwd": "${workspaceFolder}/automa-be"
      },
      "problemMatcher": []
    },
    {
      "label": "Extensions: Start Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/automa-ex"
      },
      "problemMatcher": []
    },
    {
      "label": "Extensions: Build Production",
      "type": "shell",
      "command": "npm run build:prod-chrome",
      "options": {
        "cwd": "${workspaceFolder}/automa-ex"
      },
      "problemMatcher": []
    },
    {
      "label": "Extensions: Release & Upload Wizard",
      "type": "shell",
      "command": "node utils/release.js",
      "options": {
        "cwd": "${workspaceFolder}/automa-ex"
      },
      "problemMatcher": []
    },
    {
      "label": "CLI: Lint Workflows & Packages",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    },
    {
      "label": "CLI: Push to Database",
      "type": "shell",
      "command": "npm run push -- --project=crm",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    },
    {
      "label": "CLI: Pull from Database",
      "type": "shell",
      "command": "npm run pull -- --project=crm",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    },
    {
      "label": "CLI: Check Sync Status",
      "type": "shell",
      "command": "npm run status -- --project=crm",
      "options": {
        "cwd": "${workspaceFolder}/automa-vault"
      },
      "problemMatcher": []
    }
  ]
}