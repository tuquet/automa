{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Dev Orchestrator (Interactive TUI)",
      "type": "shell",
      "command": "pnpm run dev:all",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📦 Build All (Turborepo)",
      "type": "shell",
      "command": "pnpm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Test All (Unit & Rust)",
      "type": "shell",
      "command": "pnpm run test && pnpm run test:core",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "🧩 Build VS Code Extension",
      "type": "shell",
      "command": "pnpm --filter=vscode-automa run build",
      "problemMatcher": []
    }
  ]
}