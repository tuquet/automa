{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "install"
      }
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "pnpm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build: VSCode",
      "type": "shell",
      "command": "pnpm -F vscode-automa run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Watch: VSCode",
      "type": "shell",
      "command": "pnpm dev:vscode",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "tsup",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Build start.*$",
          "endsPattern": "^.*Build success.*$"
        }
      }
    },
    {
      "label": "Watch: Webview",
      "type": "shell",
      "command": "pnpm -F vscode-automa run watch:webview",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(building|transforming).*$",
          "endsPattern": "^.*(built in|modules transformed).*$"
        }
      }
    },
    {
      "label": "Watch: Runner",
      "type": "shell",
      "command": "pnpm dev:source:runner",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(building|compiling).*$",
          "endsPattern": "^.*compiled.*$"
        }
      }
    },
    {
      "label": "Watch: Studio",
      "type": "shell",
      "command": "pnpm dev:source:studio",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": {
        "owner": "webpack-studio",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(building|compiling).*$",
          "endsPattern": "^.*compiled.*$"
        }
      }
    },
    {
      "label": "Build: Studio",
      "type": "shell",
      "command": "pnpm build:studio",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Watch: Rust",
      "type": "shell",
      "command": "cargo watch -x run",
      "options": {
        "cwd": "${workspaceFolder}/automa-core"
      },
      "isBackground": true,
      "presentation": {
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "rust",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(Compiling|Automa Core|Checking).*$",
          "endsPattern": "^.*(listening on|Server listening).*$"
        }
      }
    },
    {
      "label": "Run: Rust EXE",
      "type": "process",
      "command": "${workspaceFolder}/automa-core/target/release/automa-core",
      "windows": {
        "command": "${workspaceFolder}/automa-core/target/release/automa-core.exe"
      },
      "args": [
        "serve"
      ],
      "options": {
        "cwd": "${workspaceFolder}/automa-core/target/release"
      },
      "isBackground": true,
      "presentation": {
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "rust-exe",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Automa Core.*$",
          "endsPattern": "^.*listening on.*$"
        }
      }
    },
    {
      "label": "Serve (Live Rust)",
      "dependsOn": [
        "Watch: Rust",
        "Watch: Runner",
        "Watch: VSCode",
        "Watch: Webview"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Serve (Rust EXE)",
      "dependsOn": [
        "Run: Rust EXE",
        "Watch: Runner",
        "Watch: VSCode",
        "Watch: Webview"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Serve: Live Studio",
      "dependsOn": [
        "Watch: Rust",
        "Watch: Studio"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Open: Live Studio (Browser)",
      "type": "shell",
      "command": "cmd /c start http://127.0.0.1:8765/studio/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Sync All APIs (Docs & Bruno)",
      "type": "shell",
      "command": "pnpm run sync:api",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}