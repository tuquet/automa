{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:core",
      "type": "shell",
      "command": "cargo build --manifest-path automa-core/Cargo.toml",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "build:vsce",
      "type": "shell",
      "command": "pnpm -F vscode-automa run build",
      "problemMatcher": ["$tsup"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "📦 Automa: Build All",
      "type": "shell",
      "command": "pnpm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsup", "$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "🧪 Automa: Test Matrix",
      "type": "shell",
      "command": "pnpm run test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "🧙 Automa: Master Wizard",
      "type": "shell",
