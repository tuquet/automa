{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workspace: Install Dependencies",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "install"
      }
    },
    {
      "label": "Workspace: Build All",
      "type": "shell",
      "command": "pnpm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Workspace: Dev VSCode Host",
      "type": "shell",
      "command": "pnpm dev:vscode",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "tsup",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Build start.*$",
          "endsPattern": "^.*Build success.*$"
        }
      }
    },
    {
      "label": "Workspace: Dev Source VSCode UI",
      "type": "shell",
      "command": "pnpm dev:source:vscode",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "compiled .*"
        }
      }
    },
    {
      "label": "Workspace: Dev Source Runner",
      "type": "shell",
      "command": "pnpm dev:source:runner",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "hidden": true
      },
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "compiled .*"
        }
      }
    },
    {
      "label": "Workspace: Dev VSCode",
      "dependsOn": [
        "Workspace: Dev Source VSCode UI",
        "Workspace: Dev Source Runner",
        "Workspace: Dev VSCode Host"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workspace: Dev CLI",
      "type": "shell",
      "command": "pnpm dev:cli",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Workspace: Run CLI Tests",
      "type": "shell",
      "command": "pnpm run test:report",
      "options": {
        "cwd": "${workspaceFolder}/automa-cli"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}