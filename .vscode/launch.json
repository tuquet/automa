{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (Live Rust)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vscode/dist/**/*.js"
      ],
      "preLaunchTask": "Serve (Live Rust)"
    },
    {
      "name": "Debug (Rust EXE)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vscode/dist/**/*.js"
      ],
      "preLaunchTask": "Serve (Rust EXE)"
    }
  ]
}
