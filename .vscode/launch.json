{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🧩 Debug VS Code Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vsce"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vsce/dist/**/*.js"
      ],
      "preLaunchTask": "🧩 Build VS Code Extension"
    },
    {
      "name": "🌐 Debug Web Studio (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8765/studio/",
      "webRoot": "${workspaceFolder}/automa-webe"
    }
  ]
}
