{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Automa VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vscode/dist/**/*.js"
      ],
      "preLaunchTask": "Workspace: Dev VSCode"
    }
  ]
}
