{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🦀 Debug: Automa Core (Rust Daemon)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/apps/core/target/debug/automa-core${command:extension.vscode-lldb.executableSuffix}",
      "args": [
        "--port",
        "8765"
      ],
      "cwd": "${workspaceFolder}/apps/core",
      "preLaunchTask": "build:core"
    }
  ]
}
