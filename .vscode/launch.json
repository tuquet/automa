{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "⚡ Extension: Fast Launch (1s)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vscode/dist/**/*.js"
      ],
      "preLaunchTask": "Build: VSCode"
    },
    {
      "name": "🚀 Full-stack: Extension + Live Rust Backend",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vscode/dist/**/*.js"
      ],
      "preLaunchTask": "Serve (Live Rust)"
    },
    {
      "name": "📦 Full-stack: Extension + Rust EXE",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vscode/dist/**/*.js"
      ],
      "preLaunchTask": "Serve (Rust EXE)"
    }
  ]
}
