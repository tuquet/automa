{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🦀 Debug: Automa Core (Rust Daemon)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/automa-core/target/debug/automa-core${command:extension.vscode-lldb.executableSuffix}",
      "args": [
        "--port",
        "8765"
      ],
      "cwd": "${workspaceFolder}/automa-core",
      "preLaunchTask": "build:core"
    },
    {
      "name": "🧩 Debug: VS Code Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/automa-vsce"
      ],
      "outFiles": [
        "${workspaceFolder}/automa-vsce/dist/**/*.js"
      ],
      "preLaunchTask": "build:vsce"
    }
  ]
}
