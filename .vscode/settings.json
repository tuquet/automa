{
	"search.useIgnoreFiles": false,
	"search.exclude": {
		"**/node_modules": true,
		"**/target": true,
		"**/dist": true,
		"**/.turbo": true,
		"**/.metadata": true,
		"**/.git": true
	},
	"files.exclude": {
		"**/.git": true,
		"**/target": true,
		"**/dist": true,
		"**/.turbo": true
	},
	"editor.defaultFormatter": "biomejs.biome",
	"terminal.integrated.env.windows": {
		"PATH": "${env:USERPROFILE}\\scoop\\shims;${env:USERPROFILE}\\.cargo\\bin;${env:PATH}"
	},
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, pnpm-workspace.yaml, .npmrc, .pnpmfile.cjs",
		"tsconfig.json": "tsconfig.*.json",
		"tsup.config.ts": "tsup.config.*.ts",
		"README.md": "CHANGELOG.md, LICENSE, CONTRIBUTING.md, CODE_OF_CONDUCT.md",
		".env": "*.env, .env.*, .envrc, env.d.ts",
		".gitignore": ".gitattributes, .gitmodules, .gitkeep",
		"*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.map, ${capture}.test.ts, ${capture}.spec.ts",
		"*.tsx": "${capture}.ts, ${capture}.js, ${capture}.css, ${capture}.scss, ${capture}.module.css, ${capture}.test.tsx, ${capture}.spec.tsx",
		"*.vue": "${capture}.ts, ${capture}.js, ${capture}.css, ${capture}.scss, ${capture}.test.ts",
		"vitest.config.ts": "vitest.workspace.ts, vitest.setup.ts",
		"biome.json": "biome.jsonc"
	}
}
