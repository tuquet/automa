{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:runner", "build:studio"],
      "outputs": ["dist/**", "out/**"]
    },
    "build:runner": {
      "outputs": ["dist/cli-runner/**", "build-zip/runner.zip"]
    },
    "build:studio": {
      "outputs": ["dist/studio/**"]
    },
    "build:core": {
      "dependsOn": ["build:runner", "build:studio"],
      "outputs": ["automa-core/target/release/automa-core*"]
    },
    "build:webview": {
      "outputs": ["dist/webview/**", "webview-ui/dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:vsce": {
      "cache": false,
      "persistent": true
    },
    "dev:runner": {
      "cache": false,
      "persistent": true
    },
    "dev:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
