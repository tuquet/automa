  "cards": [
    {
      "dot": "violet",
      "title": "Multi-Repository Architecture",
      "items": [
        "tuquet/cloud: Multi-tenant control plane, campaign run queues, and centralized crawler database",
        "tuquet/runner: Rust process supervisor with 0.1ms Win32 Job Object containment",
        "tuquet/automa: Visual workflow editor & Axum daemon with HttpRequestBlock API triggers",
        "tuquet/browser: Dedicated Rust antidetect engine, multi-profile sandbox & CDP proxy"
      ]
    },
    {
      "dot": "rose",
      "title": "Zero-Zombie & Anti-Detect Isolation",
      "items": [
        "tuquet/runner guarantees 0.1ms atomic teardown of child Chrome processes via Win32 Job Objects",
        "tuquet/browser isolates cookies, Canvas/WebGL fingerprints, and proxies inside ~/.tuquet/runtimes/"
      ]
    },
    {
      "dot": "emerald",
      "title": "Closed-Loop Cloud Ingestion",
      "items": [
        "Automa workflow DAG triggers authenticated HTTP POST requests directly into tuquet/cloud",
        "Campaign runs automatically record duration, masked execution logs, and scraped JSON payloads"
      ]
    }
  ]
