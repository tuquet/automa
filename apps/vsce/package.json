{
  "name": "vscode-automa",
  "private": true,
  "publisher": "tuquet",
  "displayName": "Automa Core Toolkit",
  "description": "VS Code integration for the Automa Ecosystem (Core & Studio)",
  "version": "1.0.3",
  "icon": "assets/logo.png",
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tuquet/automa-vscode.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "menus": {
      "explorer/context": [
        {
          "submenu": "automa.explorerSubmenu",
          "when": "resourceExtname == .json",
          "group": "automa@1"
        },
        {
          "command": "automa.copyEscapedPath",
          "when": "resourceScheme == 'file'",
          "group": "4_search@2"
        }
      ],
      "automa.explorerSubmenu": [
        {
          "command": "automa.runWorkflow",
          "when": "resourceExtname == .json",
          "group": "1_run@1"
        },
        {
          "command": "automa.importWorkflowToDb",
          "when": "resourceExtname == .json",
          "group": "1_run@2"
        },
        {
          "command": "automa.runCampaign",
          "when": "resourceExtname == .json",
          "group": "1_run@3"
        },
        {
          "command": "automa.lintCheck",
          "when": "resourceExtname == .json",
          "group": "2_tools@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "automa.runWorkflow",
          "when": "resourceFilename =~ /.*\\.(workflow|package|automa)\\.json$/ || activeCustomEditorId == 'automa.workflowEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.runCampaign",
          "when": "resourceFilename =~ /.*\\.campaigns?\\.json$/ || activeCustomEditorId == 'automa.campaignEditor'",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "automa.openInStudio",
          "when": "resourceFilename =~ /.*\\.(workflow|package|automa)\\.json$/ || activeCustomEditorId == 'automa.workflowEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showWorkflowSource",
          "when": "activeCustomEditorId == 'automa.workflowEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showWorkflowPreview",
          "when": "resourceFilename =~ /.*\\.(workflow|package|automa)\\.json$/ && activeCustomEditorId != 'automa.workflowEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showCampaignSource",
          "when": "activeCustomEditorId == 'automa.campaignEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showCampaignPreview",
          "when": "resourceExtname == .json && resourceFilename =~ /.*\\.campaigns?\\.json$/ && activeCustomEditorId != 'automa.campaignEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showLogSource",
          "when": "activeCustomEditorId == 'automa.logEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showLogPreview",
          "when": "resourceFilename =~ /automa-log.json/ && activeCustomEditorId != 'automa.logEditor'",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "automa.showWorkflowPreview",
          "when": "resourceFilename =~ /.*\\.(workflow|package|automa)\\.json$/ && activeCustomEditorId != 'automa.workflowEditor'",
          "group": "navigation"
        },
        {
          "command": "automa.showCampaignPreview",
          "when": "resourceExtname == .json && resourceFilename =~ /.*\\.campaigns?\\.json$/ && activeCustomEditorId != 'automa.campaignEditor'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "automa.showLiveLog",
          "when": "view == automa.workspace || view == automa.storage",
          "group": "navigation"
        },
        {
          "command": "automa.createBrowser",
          "when": "view == automa.browsers",
          "group": "navigation@0"
        },
        {
          "command": "automa.importBrowsersFromCsv",
          "when": "view == automa.browsers",
          "group": "navigation@1"
        },
        {
          "command": "automa.refreshBrowsers",
          "when": "view == automa.browsers",
          "group": "navigation@2"
        },
        {
          "command": "automa.killAllBrowsers",
          "when": "view == automa.browsers",
          "group": "navigation@3"
        },
        {
          "command": "automa.createWorkflow",
          "when": "view == automa.workspace",
          "group": "navigation@0"
        },
        {
          "command": "automa.importWorkflowToDb",
          "when": "view == automa.workspace",
          "group": "navigation@1"
        },
        {
          "command": "automa.createCampaign",
          "when": "view == automa.workspace",
          "group": "navigation@2"
        },
        {
          "command": "automa.createPackage",
          "when": "view == automa.workspace",
          "group": "navigation@3"
        },
        {
          "command": "automa.refreshWorkspace",
          "when": "view == automa.workspace",
          "group": "navigation@4"
        },
        {
          "command": "automa.addCredential",
          "when": "view == automa.storage",
          "group": "navigation@1"
        },
        {
          "command": "automa.addVariable",
          "when": "view == automa.storage",
          "group": "navigation@2"
        },
        {
          "command": "automa.addTable",
          "when": "view == automa.storage",
          "group": "navigation@3"
        },
        {
          "command": "automa.exportStorageBackup",
          "when": "view == automa.storage",
          "group": "navigation@4"
        },
        {
          "command": "automa.importBackup",
          "when": "view == automa.storage",
          "group": "navigation@5"
        },
        {
          "command": "automa.refreshStorage",
          "when": "view == automa.storage",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "automa.runWorkflow",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "inline@1"
        },
        {
          "command": "automa.runWorkflow",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "1_actions@1"
        },
        {
          "command": "automa.showWorkflowPreview",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "inline@2"
        },
        {
          "command": "automa.showWorkflowPreview",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "1_actions@2"
        },
        {
          "command": "automa.showWorkflowSource",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "2_open@1"
        },
        {
          "command": "automa.exportWorkflowToFile",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "3_export@1"
        },
        {
          "command": "automa.deleteWorkflow",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "inline@3"
        },
        {
          "command": "automa.deleteWorkflow",
          "when": "viewItem == automaFileItem-automa.workflows || viewItem == automaFileItem-automa.packages",
          "group": "9_delete@1"
        },
        {
          "command": "automa.runCampaign",
          "when": "viewItem == automaFileItem-automa.campaigns",
          "group": "inline@1"
        },
        {
          "command": "automa.runCampaign",
          "when": "viewItem == automaFileItem-automa.campaigns",
          "group": "1_actions@1"
        },
        {
          "command": "automa.showCampaignPreview",
          "when": "viewItem == automaFileItem-automa.campaigns",
          "group": "inline@2"
        },
        {
          "command": "automa.showCampaignPreview",
          "when": "viewItem == automaFileItem-automa.campaigns",
          "group": "1_actions@2"
        },
        {
          "command": "automa.showCampaignSource",
          "when": "viewItem == automaFileItem-automa.campaigns",
          "group": "2_open@1"
        },
        {
          "command": "automa.deleteCampaign",
          "when": "viewItem == automaFileItem-automa.campaigns",
          "group": "inline@3"
        },
        {
          "command": "automa.deleteCampaign",
          "when": "viewItem == automaFileItem-automa.campaigns",
          "group": "9_delete@1"
        },
        {
          "command": "automa.createWorkflow",
          "when": "viewItem == Root_Workflows",
          "group": "inline@1"
        },
        {
          "command": "automa.importWorkflowToDb",
          "when": "viewItem == Root_Workflows",
          "group": "inline@2"
        },
        {
          "command": "automa.createCampaign",
          "when": "viewItem == Root_Campaigns",
          "group": "inline@1"
        },
        {
          "command": "automa.importCampaignToDb",
          "when": "viewItem == Root_Campaigns",
          "group": "inline@2"
        },
        {
          "command": "automa.createPackage",
          "when": "viewItem == Root_Packages",
          "group": "inline"
        },
        {
          "command": "automa.deleteStorageItem",
          "when": "view == automa.storage && (viewItem == Variable || viewItem == Credential || viewItem == Table)",
          "group": "inline"
        },
        {
          "command": "automa.addCredential",
          "when": "view == automa.storage && viewItem == Category-Secrets",
          "group": "inline"
        },
        {
          "command": "automa.addVariable",
          "when": "view == automa.storage && viewItem == Category-Variables",
          "group": "inline"
        },
        {
          "command": "automa.addTable",
          "when": "view == automa.storage && viewItem == Category-Tables",
          "group": "inline"
        },
        {
          "command": "automa.openTable",
          "when": "view == automa.storage && viewItem == Table",
          "group": "inline@1"
        },
        {
          "command": "automa.launchBrowser",
          "when": "view == automa.browsers && viewItem == automaBrowserItem-offline",
          "group": "inline@1"
        },
        {
          "command": "automa.stopBrowser",
          "when": "view == automa.browsers && viewItem == automaBrowserItem-online",
          "group": "inline@1"
        },
        {
          "command": "automa.executeWorkflowOnBrowser",
          "when": "view == automa.browsers && viewItem == automaBrowserItem-online",
          "group": "1_actions@1"
        },
        {
          "command": "automa.sideloadExtension",
          "when": "view == automa.browsers",
          "group": "1_actions@2"
        },
        {
          "command": "automa.editBrowser",
          "when": "view == automa.browsers",
          "group": "2_edit@1"
        },
        {
          "command": "automa.deleteBrowser",
          "when": "view == automa.browsers && viewItem == automaBrowserItem-offline",
          "group": "inline@2"
        },
        {
          "command": "automa.deleteBrowser",
          "when": "view == automa.browsers && viewItem == automaBrowserItem-offline",
          "group": "9_delete@1"
        },
        {
          "command": "automa.killBrowser",
          "when": "view == automa.browsers && viewItem == automaBrowserItem-online",
          "group": "9_delete@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "automa.deleteWorkflow",
        "key": "delete",
        "mac": "backspace",
        "when": "focusedView == 'automa.workspace' && (viewItem == 'automaFileItem-automa.workflows' || viewItem == 'automaFileItem-automa.packages')"
      },
      {
        "command": "automa.deleteCampaign",
        "key": "delete",
        "mac": "backspace",
        "when": "focusedView == 'automa.workspace' && viewItem == 'automaFileItem-automa.campaigns'"
      }
    ],
    "submenus": [
      {
        "id": "automa.explorerSubmenu",
        "label": "Automa Toolkit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "automa-activity-bar",
          "title": "Automa Ecosystem",
          "icon": "resources/automa-icon.svg"
        }
      ]
    },
    "views": {
      "automa-activity-bar": [
        {
          "id": "automa.workspace",
          "name": "AUTOMATIONS",
          "icon": "$(play-circle)",
          "contextualTitle": "Automa Automations"
        },
        {
          "id": "automa.browsers",
          "name": "BROWSERS",
          "icon": "$(globe)",
          "contextualTitle": "Automa Browsers"
        },
        {
          "id": "automa.storage",
          "name": "STORAGE",
          "icon": "$(database)",
          "contextualTitle": "Automa Storage"
        }
      ]
    },
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".workflow.json",
          ".package.json",
          ".automa-var.json",
          ".automa-table.json",
          ".automa-rows.json",
          ".automa-cred.json",
          ".automa-folder.json",
          ".campaigns.json"
        ]
      }
    ],
    "commands": [
      {
        "command": "automa.copyEscapedPath",
        "title": "Copy Path (/)",
        "category": "Automa"
      },
      {
        "command": "automa.showWorkflowSource",
        "title": "Show Workflow Source",
        "icon": "$(code)",
        "category": "Automa"
      },
      {
        "command": "automa.showWorkflowPreview",
        "title": "Preview Workflow",
        "icon": "$(preview)",
        "category": "Automa"
      },
      {
        "command": "automa.showCampaignSource",
        "title": "Show Campaign Source",
        "icon": "$(code)",
        "category": "Automa"
      },
      {
        "command": "automa.showCampaignPreview",
        "title": "Preview Campaign",
        "icon": "$(preview)",
        "category": "Automa"
      },
      {
        "command": "automa.runWorkflow",
        "title": "Run Workflow",
        "icon": "$(play)",
        "category": "Automa"
      },
      {
        "command": "automa.runCampaign",
        "title": "Run Campaign",
        "icon": "$(play)",
        "category": "Automa"
      },
      {
        "command": "automa.lintCheck",
        "title": "Lint Check Workflow",
        "icon": "$(checklist)",
        "category": "Automa"
      },
      {
        "command": "automa.showLogSource",
        "title": "Show Source",
        "icon": "$(code)",
        "category": "Automa"
      },
      {
        "command": "automa.showLogPreview",
        "title": "Open Preview",
        "icon": "$(preview)",
        "category": "Automa"
      },
      {
        "command": "automa.openInStudio",
        "title": "Open in Studio",
        "icon": "$(link-external)",
        "category": "Automa"
      },
      {
        "command": "automa.createWorkflow",
        "title": "Create Workflow",
        "icon": "$(new-file)",
        "category": "Automa"
      },
      {
        "command": "automa.importWorkflowToDb",
        "title": "Import Workflow / Package to Database (*.json)",
        "icon": "$(cloud-upload)",
