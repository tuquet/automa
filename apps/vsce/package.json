      },
      {
        "command": "automa.deleteStorageItem",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Automa"
      },
      {
        "command": "automa.selectDefaultBrowser",
        "title": "Select Default Browser",
        "category": "Automa Run"
      },
      {
        "command": "automa.importBrowsersFromCsv",
        "title": "Import Browsers from CSV",
        "category": "Automa"
      },
      {
        "command": "automa.sideloadExtension",
        "title": "Sideload Extension",
        "category": "Automa"
      },
      {
        "command": "automa.executeWorkflowOnBrowser",
        "title": "Execute Workflow on Browser",
        "category": "Automa"
      },
      {
