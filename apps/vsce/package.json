        "title": "Stop Campaign",
        "icon": "$(debug-stop)",
        "category": "Automa"
      }
    ],
    "customEditors": [
      {
        "viewType": "automa.logEditor",
        "displayName": "Automa Execution Log",
        "selector": [
          {
            "filenamePattern": "*.automa-log.json"
          }
        ]
      },
      {
        "viewType": "automa.workflowEditor",
        "displayName": "Automa Workflow Editor",
        "selector": [
          {
            "filenamePattern": "*.workflow.json"
          },
          {
            "filenamePattern": "*.package.json"
          },
          {
            "filenamePattern": "*.automa.json"
          }
        ]
      },
      {
        "viewType": "automa.campaignEditor",
        "displayName": "Campaign Editor",
        "selector": [
          {
            "filenamePattern": "*.campaign.json"
          },
          {
            "filenamePattern": "*.campaigns.json"
          }
        ]
      },
      {
        "viewType": "automa.browserEditor",
        "displayName": "Automa Browser Editor",
        "selector": [
          {
            "filenamePattern": "*.browser.json"
          }
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "*.workflow.json",
          "*.package.json"
        ],
        "url": "./schemas/workflow.schema.json"
      },
      {
        "fileMatch": [
          "*.campaign.json",
          "*.campaigns.json"
        ],
        "url": "./schemas/campaign.schema.json"
      },
      {
        "fileMatch": [
          "*.browser.json"
        ],
        "url": "./schemas/browser.schema.json"
      }
    ],
    "configuration": [
      {
        "title": "Automa: Workflow Execution & Core",
        "properties": {
          "automa.preview.defaultOnClick": {
            "type": "boolean",
            "default": true,
            "description": "Set Automa Workflow/Package Preview as the default editor when clicking on *.workflow.json or *.package.json files."
          },
          "automa.run.defaultBrowser": {
            "type": "string",
            "default": "daemon_worker",
            "description": "Default Browser ID to use when running workflows from the UI."
          },
          "automa.run.useDefaultParameters": {
            "type": "boolean",
            "default": false,
            "description": "Skip interactive prompts for workflow trigger parameters and always use default values."
          },
          "automa.run.headless": {
            "type": "boolean",
            "default": false,
            "description": "Run the browser in headless mode."
          },
          "automa.run.closeBrowserOnFinish": {
            "type": "boolean",
            "default": true,
            "description": "Automatically close the browser when the workflow finishes."
          },
          "automa.run.debug": {
            "type": "boolean",
            "default": false,
            "description": "Enable verbose debug logging for execution."
          },
          "automa.run.campaignGridSystem": {
            "type": "boolean",
            "default": true,
            "description": "Enable Grid System to automatically allocate and position browser windows when running Automa Campaign."
          },
          "automa.core.port": {
            "type": "number",
            "default": 8765,
            "description": "Base port for the Automa Core background server. The extension will automatically connect to this port."
          },
          "automa.encryptionPassphrase": {
            "type": "string",
            "default": "",
            "description": "Passphrase used to encrypt credentials in the Automa Global Storage."
          }
        }
      },
      {
        "title": "Automa: Environment & Logs",
        "properties": {
          "automa.run.globalVariables": {
            "type": "object",
            "default": {},
            "description": "Global variables (JSON object) appended to the workflow run parameters.",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    ],
    "viewsWelcome": [
      {
        "view": "automa.workspace",
        "contents": "No files found in workspace.\n[$(new-file) Create Workflow](command:automa.createWorkflow)\n[$(rocket) Create Campaign](command:automa.createCampaign)\n[$(refresh) Refresh](command:automa.refreshWorkspace)"
      },
      {
        "view": "automa.browsers",
        "contents": "No browsers found.\n[$(add) Create Browser](command:automa.createBrowser)\n[$(refresh) Refresh](command:automa.refreshBrowsers)"
      },
      {
        "view": "automa.storage",
        "contents": "Automa Global Storage (Secrets, Variables, Tables).\n[$(refresh) Refresh Storage](command:automa.refreshStorage)"
      }
    ]
  },
  "scripts": {
    "generate:api": "pnpm -F @automa/types run generate:api",
    "build": "tsup",
    "dev": "pnpm run watch",
    "vscode:prepublish": "tsup",
    "compile": "tsup",
    "watch": "tsup --watch",
    "lint": "tsc --noEmit && biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist out *.vsix .turbo",
    "package": "pnpm run test && npx vsce package --no-dependencies -o automa-vscode.vsix",
    "package:dev": "cross-env VSIX_ENV=dev npx vsce package --no-dependencies -o automa-vscode-dev.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check": "biome check --write",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@automa/types": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "^3.0.0",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vscode/test-electron": "^3.1.0",
    "cross-env": "^7.0.3",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "playwright": "^1.62.1",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
