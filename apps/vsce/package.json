        "category": "Automa"
      },
      {
        "command": "automa.createCampaign",
        "title": "Create Campaign",
        "icon": "$(rocket)",
        "category": "Automa"
      },
      {
        "command": "automa.importCampaignToDb",
        "title": "Import Campaign to Database (*.campaign.json)",
        "icon": "$(cloud-upload)",
