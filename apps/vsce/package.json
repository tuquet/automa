      },
      {
        "command": "automa.createBrowser",
        "title": "Create Browser",
        "icon": "$(add)",
        "category": "Automa"
      },
      {
        "command": "automa.refreshWorkspace",
        "title": "Refresh Workspace",
        "icon": "$(refresh)",
        "category": "Automa"
      },
      {
        "command": "automa.refreshBrowsers",
        "title": "Refresh Browsers",
        "icon": "$(refresh)",
        "category": "Automa"
      },
      {
        "command": "automa.refreshStorage",
        "title": "Refresh Storage",
