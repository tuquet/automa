:"","time":"00:00","type":"manual","url":""},"id":"tlsy","initialized":false,"label":"trigger","position":{"x":200,"y":190},"type":"BlockBasic"},{"data":{"assignVariable":true,"body":"{}","contentType":"json","dataColumn":"","dataPath":"","description":"Lấy dữ liệu chấm công","disableBlock":false,"headers":[{"name":"Authorization","value":"Bearer {{variables.bearer_token}}"},{"name":"Origin","value":"https://hrms.cmcglobal.com.vn"},{"name":"Referer","value":"https://hrms.cmcglobal.com.vn/"}],"method":"GET","responseType":"json","saveData":false,"timeout":10000,"url":"https://hrms-be.cmcglobal.com.vn/api/tms/timesheets/flexible/{{variables.payroll_periodId}}/employee/{{variables.employee_id}}","variableName":"timesheetData"},"id":"oc0r","initialized":false,"label":"webhook","position":{"x":2375,"y":62.5},"type":"BlockBasicWithFallback"},{"data":{"code":"const data = automaRefData('variables', 'timesheetData');\nconst timesheets = data.data.timesheets;\n\n// Lấy ngưỡng tự động xin nghỉ KHÔNG LƯƠNG từ biến do user cài đặt (Mặc định: <= 60 phút)\n// User có thể vào mục Variables của Automa để tự thêm biến \"max_unpaid_minutes\" (VD: 30)\nconst maxUnpaidMinutes = Number(automaRefData('variables', 'max_unpaid_minutes')) || 60;\n\nlet lateDays = [];\n\ntimesheets.forEach(day => {\n  // 1. Chỉ lấy những ngày CÓ ĐI MUỘN\n  const hasLateTime = (day.absent_time > 0);\n  \n  // 2. Ép kiểu an toàn: >= 1 (tức >= 1.0) thì là đủ công.\n  const isFullAttendance = (Number(day.value) >= 1);\n  const notFullAttendance = !isFullAttendance;\n\n  // 3. CHƯA CÓ ĐƠN (trống ở cả 2 trường)\n  const noRequests = (!day.requests || day.requests.length === 0);\n  const noRequestDetails = (!day.request_detail || day.request_detail.length === 0);\n\n  // 4. CHỈ LÀM TỰ ĐỘNG NẾU NHỎ HƠN HOẶC BẰNG NGƯỠNG CHO PHÉP (VD <= 60 phút)\n  // Nếu đi muộn quá lố (VD: 120 phút), thì bỏ qua để User tự vào web xin Nghỉ Có Lương\n  const withinUnpaidThreshold = (day.absent_time <= maxUnpaidMinutes);\n\n  if (hasLateTime && notFullAttendance && noRequests && noRequestDetails && withinUnpaidThreshold) {\n    const rawDate = day.date_of_issue.split(' ')[0];\n    lateDays.push({\n      date: `${rawDate} 00:00:00`,\n      minutes: day.absent_time\n    });\n  }\n});\n\nautomaSetVariable('lateDays', lateDays);\nautomaNextBlock();","context":"background","description":"Lọc ngày đi muộn & Format","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":20000},"id":"d848","initialized":false,"label":"javascript-code","position":{"x":2725,"y":50},"type":"BlockBasic"},{"data":{"description":"Lặp qua biến lateDays","disableBlock":false,"elementSelector":"","fromNumber":1,"loopData":"[]","loopId":"late-loop","loopThrough":"variable","maxLoop":"{{variables.test_limit}}","referenceKey":"","resumeLastWorkflow":false,"reverseLoop":false,"startIndex":0,"toNumber":10,"variableName":"lateDays","waitForSelector":false,"waitSelectorTimeout":5000},"id":"ojh2","initialized":false,"label":"loop-data","position":{"x":3425,"y":50},"type":"BlockBasic"},{"data":{"code":"const loopItem = automaRefData('loopData', 'late-loop');\n\n// Lấy dữ liệu tương thích cả 2 bản (Gốc và Mod)\nconst itemDate = loopItem.date || (loopItem.data ? loopItem.data.date : '');\nconst rawMinutes = (loopItem.minutes !== undefined) ? loopItem.minutes : ((loopItem.data && loopItem.data.minutes !== undefined) ? loopItem.data.minutes : 0);\n\nlet reqMinutes = parseInt(rawMinutes) || 0;\nif (reqMinutes > 480) reqMinutes = 480;\n\nconst payload = {\n  \"request_type\": \"TIME_OFF\",\n  \"reason_type\": \"LOA_CORP_4\",\n  \"description\": \"Em xin đến muộn em sẽ làm bù cuối ngày không để ảnh hưởng tiến độ dự án ạ.\",\n  \"mail_cc\": [],\n  \"employee\": automaRefData('variables', 'employee_id'),\n  \"request_dates\": [{ \"request_date\": itemDate, \"request_minutes\": reqMinutes }],\n  \"time_leave\": null\n};\n\nautomaSetVariable('post_payload', JSON.stringify(payload));\nautomaNextBlock();","context":"website","description":"Fetch API trực tiếp trên trang HRMS","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":30000},"id":"w4ez","initialized":false,"label":"javascript-code","position":{"x":3775,"y":50},"type":"BlockBasic"},{"data":{"description":"Tránh rate limit","disableBlock":false,"time":2000},"id":"0zt3","initialized":false,"label":"delay","position":{"x":4825,"y":50},"type":"BlockDelay"},{"data":{"clearLoop":false,"description":"Kết thúc vòng lặp","disableBlock":false,"loopId":"late-loop"},"id":"43l0","initialized":false,"label":"loop-breakpoint","position":{"x":5175,"y":50},"type":"BlockLoopBreakpoint"},{"data":{"active":true,"customUserAgent":false,"description":"new-tab","disableBlock":false,"inGroup":false,"tabZoom":1,"updatePrevTab":true,"url":"https://hrms.cmcglobal.com.vn","userAgent":"","waitTabLoaded":true},"id":"63ade2t","initialized":false,"label":"new-tab","position":{"x":625,"y":190},"type":"BlockBasic"},{"data":{"conditions":[{"conditions":[{"conditions":[{"id":"4bOjQux82rf0-lwxsu7dz","items":[{"category":"value","data":{"value":"{{variables.activeTabUrl}}"},"id":"vl4-CinXvZfl6uUWpr1rM","type":"value"},{"category":"compare","id":"tUGEXdSXvKeU3zRpebTt-","type":"enw"},{"category":"value","data":{"value":"/timesheet"},"id":"QufMw0ArN1xE2Df1LvXVC","type":"value"}]}],"id":"RVeLoMYril8Yu_cqnaOZ9"}],"id":"9fc34FQCg2KVHNFIQ0eFs","name":"TimeSheet Page"},{"conditions":[{"conditions":[{"id":"3nZ4coAaO9X72ksFg_JDl","items":[{"category":"value","data":{"selector":"input#normal_login_username"},"id":"azplI75qnLwe6RpJQrZll","type":"element#exists"}]}],"id":"z_2JBD550gI24WXMnKR0b"}],"id":"L20168VHHmEULvkfy4TC6","name":"Login Page"}],"description":"Check activeTabUrl","disableBlock":false,"retryConditions":false,"retryCount":10,"retryTimeout":1000},"id":"r2q4hil","initialized":false,"label":"conditions","position":{"x":1325,"y":190},"type":"BlockConditions"},{"data":{"assignVariable":true,"dataColumn":"","descript