ms","position":{"x":96,"y":36},"type":"BlockBasic"},{"data":{"assignVariable":false,"clearValue":true,"dataColumn":"","delay":"50","description":"","disableBlock":false,"events":[],"findBy":"cssSelector","getValue":false,"markEl":true,"multiple":false,"optionPosition":"1","saveData":false,"selectOptionBy":"value","selected":true,"selector":"input#normal_login_password","type":"text-field","value":"{{variables.password}}","variableName":"","waitForSelector":false,"waitSelectorTimeout":5000},"id":"px543i7","initialized":false,"label":"forms","position":{"x":388,"y":36},"type":"BlockBasic"},{"data":{"description":"","disableBlock":false,"findBy":"cssSelector","markEl":false,"multiple":false,"selector":"button.login-form-button","waitForSelector":false,"waitSelectorTimeout":5000},"id":"c0s5624","initialized":false,"label":"event-click","position":{"x":680,"y":36},"type":"BlockBasic"},{"data":{"description":"","disableBlock":false,"findBy":"cssSelector","markEl":false,"selector":".ant-dropdown-link.ant-dropdown-trigger > div","throwError":true,"timeout":1000,"tryCount":10},"id":"ewupis7","initialized":false,"label":"element-exists","position":{"x":1069.2363487605942,"y":5.1904677124300775},"type":"BlockElementExists"}],"position":[79,293],"viewport":{"x":79,"y":293,"zoom":0.5779825954442672},"zoom":0.5779825954442672},"description":"block-package","icon":"mdiPackageVariantClosed","id":"UW6vzgOq3qcyO1mmqFi85","inputs":[{"blockId":"gqsfjd3","handleId":"gqsfjd3-input-1","id":"fnoqman","name":""}],"isExtenal":false,"name":"Login","outputs":[{"blockId":"c0s5624","handleId":"c0s5624-output-1","id":"ntkn73m","name":""}],"settings":{"asBlock":true},"updatedAt":1784709677833,"variable":[]},"id":"6duq7ih","initialized":false,"label":"block-package","position":{"x":1675,"y":50},"type":"BlockPackage"},{"data":{"code":"\nsetTimeout(() => {\n  try {\n    // Lấy Token từ localStorage\n    let token = '';\n    const sessionLoginStr = localStorage.getItem('session_login');\n    if (sessionLoginStr) {\n      try {\n        const sessionLogin = JSON.parse(sessionLoginStr);\n        token = sessionLogin.access_token || '';\n      } catch (e) {}\n    }\n\n    // Lấy Employee ID và Payroll Period từ sessionStorage\n    let employeeId = '';\n    let payrollPeriodId = '';\n    const timesheetStr = sessionStorage.getItem('Timesheet');\n    if (timesheetStr) {\n      try {\n        const timesheet = JSON.parse(timesheetStr);\n        employeeId = timesheet.employmentID || '';\n        payrollPeriodId = timesheet.payroll_period || '';\n      } catch (e) {}\n    }\n\n    // Lưu vào biến\n    automaSetVariable('bearer_token', token);\n    automaSetVariable('employee_id', employeeId);\n    automaSetVariable('payroll_periodId', payrollPeriodId);\n    \n    automaNextBlock();\n  } catch(err) {\n    console.error('Extract error:', err);\n    automaNextBlock();\n  }\n}, 3000);\n","context":"website","description":"Auto extract Token","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":10000},"id":"auto-extract","initialized":false,"label":"javascript-code","position":{"x":2025,"y":62.5},"type":"BlockBasic"},{"data":{"color":"green","disableBlock":false,"drawing":false,"fontSize":"regular","height":415,"note":"Dưới đây là luồng chạy chi tiết của kịch bản, bao gồm 5 giai đoạn chính:\n\n### Giai đoạn 1: Khởi động và Thâm nhập (Trigger & Nav)\n1. **Trigger:** Kích hoạt kịch bản (có thể bằng tay hoặc hẹn giờ).\n2. **New Tab / Switch Tab:** Mở hoặc chuyển hướng thẳng vào trang quản lý Time & Attendance của HRMS.\n3. **Conditions:** Xác nhận xem URL hiện tại có đúng là trang HRMS không. Nếu sai thì lập tức dừng kịch bản để tránh lỗi.\n\n### Giai đoạn 2: Thu thập Tình báo (Extract Data & Token)\n4. **JavaScript Code (Thu thập Timesheet):** Chạy ngầm một đoạn mã trên trang để móc toàn bộ dữ liệu bảng chấm công (Timesheet) của tháng hiện tại ra, sau đó lưu cục dữ liệu khổng lồ này vào biến của Automa (`variables.timesheetData`).\n5. **HTTP Request / JS (Lấy Token):** Trích xuất mã xác thực `Bearer Token` và `Employee ID` của bạn từ hệ thống (Local Storage hoặc Cookies) để lấy quyền \"thái thú\" – đại diện cho bạn gửi đơn lên Server.\n\n### Giai đoạn 3: Bộ lọc Gắt gao (Sàng lọc ngày hợp lệ)\n6. **JavaScript Code (Filter Logic):** Đây là bộ não của kịch bản. Nó sẽ lấy cục Timesheet lúc nãy ra và soi từng ngày một. Một ngày đi muộn chỉ được đưa vào \"Danh sách cần xin\" (`lateDays`) nếu thỏa mãn **TOÀN BỘ 5 điều kiện** sau:\n   - Có phát sinh số phút vắng mặt (`absent_time > 0`).\n   - Tổng công ngày hôm đó chưa đủ 1.0 (nghĩa là thiếu công do đi muộn).\n   - Ngày đó **chưa từng** có bất kỳ đơn xin vắng mặt nào trước đó (tránh tạo trùng đơn).\n   - Ngày đó **không có** bất kỳ chi tiết đơn từ nào đang chờ duyệt.\n   - **Quan trọng nhất:** Số phút đi muộn phải nhỏ hơn hoặc bằng giới hạn cho phép (ví dụ `max_unpaid_minutes` = 60 phút). Đi muộn quá lâu (ví dụ 78 phút) sẽ bị bỏ qua để bạn tự xử lý tay.\n\n### Giai đoạn 4: Vòng lặp Nhả đạn (Loop & Bắn API)\n7. **Loop Data:** Bắt đầu vòng lặp qua mảng `lateDays` (những ngày đã lọt qua bộ lọc ở trên).\n8. **JavaScript Code (Active Tab - Fetch API):** Với từng ngày đi muộn, nó sẽ:\n   - Thay số phút và ngày tháng thực tế vào Payload.\n   - Bắn thẳng một request POST lên Server CMC kèm theo Token của bạn với lời nhắn: *\"Em xin đến muộn em sẽ làm bù cuối ngày không để ảnh hưởng tiến độ dự án ạ.\"*\n   - *(Lưu ý: Node này đã được bật cờ `isAsync` để Automa ngoan ngoãn đứng chờ API trả kết quả về rồi mới đi tiếp, không còn tình trạng chạy lướt qua làm sập hệ thống nữa).*\n9. **Delay (Nghỉ nhịp):** Dừng khoảng 2 giây để tránh việc bắn API quá nhanh khiến Firewall của CMC đánh dấu bạn là spammer/DDoS.\n10. **Loop Breakpoint:** Đánh dấu kết thúc xử lý 1 ngày, vòng ngược lại bước 7 để xử lý ngày tiếp theo.\n\n### Giai đoạn 5: Hoàn tất\nKhi vòng lặp đã duyệt qua hết tất cả các ngày trong danh sách `lateDays`, kịch bản tự động dừng lại. Lúc này, bạn chỉ cần F5 trang HRMS, và bùm – toàn bộ những ngày đi muộn lắt nhắt của bạn đều đã được gắn đơn tự động!\n\nQuy trình này biến một công việc nhàm chán, lặp đi lặp lại vào mỗi cuối tháng thành một nút bấm duy nhất. Rất gọn gàng và tinh xảo! 😉","width":2235},"id":"avc88bi","label":"note","position":{"x":200,"y":380},"type":"BlockNote"},{"data":{"description":"Lặp lại chờ giao diện load","disableBlock":false,"repeatFor":2,"repeatTimes":2},"id":"repeat-fallback","label":"repeat-task","position":{"x":4125,"y":297.5},"type":"BlockRepeatTask"},{"data":{"description":"Chờ 2s","disableBlock":false,"time":"2000"},"id":"delay-fallback","label":"delay","position":{"x":4475,"y":350},"type":"BlockDelay"},{"data":{"activeTab":true,"allWindows":false,"closeType":"tab","description":"Dọn dẹp tab sau khi chạy xong","disableBlock":false,"url":""},"id":"cltab99","label":"close-tab","position":{"x":5525,"y":50},"type":"BlockBasic"},{"data":{"code":"const res = automaRefData('variables', 'post_response');\nif (res && res.code && res.code !== 200 && res.code !== '200') {\n  automaSetVariable('api_error', JSON.stringify(res));\n  automaNextBlock({ success: false, error: 'API Error' });\n} else {\n  automaNextBlock({ success: true });\n}","context":"website","description":"Kiểm tra phản hồi của API tạo đơn","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":30000},"id":"fig9","label":"javascript-code","position":{"x":4475,"y":50},"type":"BlockBasic"},{"data":{"description":"Báo lỗi API","disableBlock":false,"iconUrl":"","imageUrl":"","message":"Chi tiết lỗi:\\n{{variables.api_error}}","title":"Automa Lỗi API"},"id":"2zo5","label":"notification","position":{"x":4475,"y":200},"type":"BlockBasic"},{"data":{"description":"Dừng luồng do lỗi","disableBlock":false,"errorMessage":"Lỗi API, buộc dừng luồng!","exceptCurrent":false,"throwError":true,"type":"stop-current","workflowsToStop":[]},"id":"odhq","label":"workflow-state","position":{"x":4825,"y":200},"type":"BlockBasic