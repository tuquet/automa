{
  "name": "Universal Web Crawler & Extraction Pipeline",
  "description": "Multi-tiered universal crawler extracting title, paragraph content, and links",
  "drawflow": {
    "nodes": [
      {
        "id": "node-trigger",
        "label": "trigger",
        "data": {
          "type": "manual"
        }
      },
      {
        "id": "node-new-tab",
        "label": "new-tab",
        "data": {
          "url": "https://example.com",
          "active": true
        }
      },
      {
        "id": "node-get-title",
        "label": "get-text",
        "data": {
          "selector": "h1",
          "useTextContent": true,
          "multiple": false
        }
      },
      {
        "id": "node-delay",
        "label": "delay",
        "data": {
          "time": 1000
        }
      }
    ],
    "edges": [
      {
        "id": "edge-1",
        "source": "node-trigger",
        "target": "node-new-tab",
        "sourceHandle": "node-trigger-output-1",
        "targetHandle": "node-new-tab-input-1"
      },
      {
        "id": "edge-2",
        "source": "node-new-tab",
        "target": "node-get-title",
        "sourceHandle": "node-new-tab-output-1",
        "targetHandle": "node-get-title-input-1"
      },
      {
        "id": "edge-3",
        "source": "node-get-title",
        "target": "node-delay",
        "sourceHandle": "node-get-title-output-1",
        "targetHandle": "node-delay-input-1"
      }
    ]
  },
  "settings": {
    "debugMode": false,
    "saveLog": true
  }
}
