filters:
  and:
    - file.ext == "md"
    - file.name != "Home"
formulas:
  days_since_modified: (now() - file.mtime).days
  folder_name: file.folder
properties:
  file.name:
    displayName: Tên tài liệu
  formula.folder_name:
    displayName: Phân hệ
  formula.days_since_modified:
    displayName: Cập nhật (ngày trước)
  tags:
    displayName: Tags
views:
  - type: table
    name: Tất cả tài liệu
    groupBy:
      property: formula.folder_name
      direction: ASC
    order:
      - file.name
      - formula.folder_name
      - tags
      - formula.days_since_modified
  - type: cards
    name: Dạng thẻ
    order:
      - file.name
      - formula.folder_name
      - tags
