{
  "name": "Automa Ecosystem",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [54321, 54322, 54323],
  "mounts": [
    "source=automa-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume"
  ],
  "postCreateCommand": "bash clone_all.sh",
  "postStartCommand": "cd automa-be && npx supabase start",
  "runArgs": [
    "--add-host=crm.cmcglobal.com.vn:127.0.0.1"
  ]
}
