{
  "name": "Automa Ecosystem",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {},
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "supabase.supabase-vscode",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ]
    }
  },
  "forwardPorts": [3001, 6080, 54321, 54322, 54323, 54324],
  "mounts": [
    "source=automa-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume"
  ],
  "postCreateCommand": "pnpm config set store-dir /home/node/.local/share/pnpm/store && bash init_workspace.sh",
  "runArgs": [
    "--add-host=crm.cmcglobal.com.vn:127.0.0.1"
  ]
}
