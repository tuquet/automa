{
  "name": "automa-ecosystem",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "dev:cli": "turbo run dev --filter=tuquet-automa-cli",
    "dev:vscode": "turbo run dev --filter=automa-vscode",
    "dev:source": "turbo run dev --filter=automa"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "turbo": "^2.1.2"
  },
  "lint-staged": {
    "automa-cli/**/*.{js,ts,vue}": [
      "npx @biomejs/biome check --write"
    ]
  }
}
