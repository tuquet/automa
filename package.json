{
    "name": "tuquet-automa",
    "private": true,
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "prepare": "husky",
        "setup": "node scripts/setup-ecosystem.mjs",
        "build": "turbo run build",
        "build:runner": "turbo run build --filter=@automa/runner",
        "dev": "node scripts/dev-orchestrator.mjs",
        "dev:all": "node scripts/dev-orchestrator.mjs --all",
        "dev:turbo": "turbo run dev",
        "dev:source:runner": "turbo run dev --filter=@automa/runner",
        "dev:docs": "node scripts/serve-docs.mjs",
        "test": "node scripts/test-all.mjs",
        "test:tier1": "node scripts/test-all.mjs --tier 1",
        "test:tier2": "node scripts/test-all.mjs --tier 2",
        "test:tier3": "node scripts/test-all.mjs --tier 3",
        "test:schema": "node scripts/enforce-strict-schema.mjs",
        "test:e2e": "vitest run",
        "test:ui": "vitest --ui",
        "lint": "turbo run lint && node scripts/lint-style-debt.mjs",
        "lint:style": "node scripts/lint-style-debt.mjs",
        "lint:schema": "node scripts/enforce-strict-schema.mjs",
        "lint:fix": "turbo run lint:fix",
        "format": "turbo run format",
        "format:check": "turbo run format:check",
        "typecheck": "turbo run typecheck",
        "clean": "turbo run clean && rimraf node_modules .turbo",
        "sync:api": "node scripts/sync-api.mjs",
        "postsync:api": "pnpm run lint"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@clack/prompts": "^1.7.0",
        "@sentry/node": "^10.73.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "picocolors": "^1.1.1",
        "rimraf": "^5.0.5",
        "turbo": "^2.1.2",
        "vitest": "^4.1.10",
        "ws": "^8.21.3"
    }
}