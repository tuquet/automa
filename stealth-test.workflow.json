{
  "name": "Anti-Bot & Stealth Verification Workflow",
  "description": "Tests headless browser stealthiness against fingerprint benchmarks",
  "drawflow": {
    "nodes": [
      {
        "id": "node-trigger",
        "label": "trigger",
        "data": {
          "type": "manual"
        }
      },
      {
        "id": "node-new-tab",
        "label": "new-tab",
        "data": {
          "url": "https://httpbin.org/headers",
          "active": true
        }
      },
      {
        "id": "node-get-headers",
        "label": "get-text",
        "data": {
          "selector": "pre",
          "useTextContent": true,
          "multiple": false
        }
      },
      {
        "id": "node-delay",
        "label": "delay",
        "data": {
          "time": 1000
        }
      }
    ],
    "edges": [
      {
        "id": "edge-1",
        "source": "node-trigger",
        "target": "node-new-tab",
        "sourceHandle": "node-trigger-output-1",
        "targetHandle": "node-new-tab-input-1"
      },
      {
        "id": "edge-2",
        "source": "node-new-tab",
        "target": "node-get-headers",
        "sourceHandle": "node-new-tab-output-1",
        "targetHandle": "node-get-headers-input-1"
      },
      {
        "id": "edge-3",
        "source": "node-get-headers",
        "target": "node-delay",
        "sourceHandle": "node-get-headers-output-1",
        "targetHandle": "node-delay-input-1"
      }
    ]
  },
  "settings": {
    "debugMode": false,
    "saveLog": true
  }
}
